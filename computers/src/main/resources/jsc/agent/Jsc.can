using System.*;
using System.IO.*;
using System.Collections.*;
using System.Execution.*;
using System.Network.*;

namespace Jsc;

/*
 * The command a ComputerCraft computer runs to reach the network it is bridged to.
 *
 * "jsc run <program>" fetches one of the network's programs and runs it here. It arrives ready to run:
 * a program written for those computers is compiled and translated on its way over, which is what going
 * to another kind of computer means, so there is no flag to pass and no second copy of anything kept.
 *
 * "jsc list" says what there is to run, and "jsc" alone says where this computer is standing.
 */
class Jsc {

    static void Main() {
        List<string> args = Program.Args;
        string verb = "";
        if (args.Count > 0) {
            verb = args[0];
        }
        if (!Gateway.Online) {
            Console.PrintLine("This computer cannot reach a J's network.");
            Console.PrintLine("Put a Network Gateway against it, or connect one with a modem.");
            return;
        }
        if (verb == "run") {
            Run(args);
            return;
        }
        if (verb == "list") {
            List<string> there = Gateway.Programs();
            if (there.Count == 0) {
                Console.PrintLine("The host computer has no programs to run.");
                return;
            }
            foreach (string one in there) {
                Console.PrintLine(one);
            }
            return;
        }
        Console.PrintLine("jsc run <program> [words]   run one of the network's programs here");
        Console.PrintLine("jsc list                    what there is to run");
    }

    static void Run(List<string> args) {
        if (args.Count < 2) {
            Console.PrintLine("jsc run <program> [words]");
            return;
        }
        string name = args[1];
        List<string> given = new List<string>();
        for (int i = 2; i < args.Count; i = i + 1) {
            given.Add(args[i]);
        }
        string source = Gateway.Program(name);
        if (source == "") {
            Console.PrintLine("There is no program called " + name + " on the host computer.");
            return;
        }
        Process ran = Program.RunSource(source, given, name);
        if (ran.ExitCode != 0) {
            Console.PrintLine(name + " stopped with " + ran.ExitCode + ".");
        }
    }
}
