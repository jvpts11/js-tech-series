using System.*;
using System.IO.*;
using System.Collections.*;
using System.Execution.*;
using System.Network.*;

namespace Jsc;

/*
 * What a ComputerCraft computer does for the network it is bridged to.
 *
 * This program is not run by hand: it is started by the computer itself, and on a computer with no
 * Gateway within reach it does nothing at all and is over in a line. Where there is one, it says it is
 * there and then answers what the other side asks of it, for as long as the computer is on.
 *
 * Everything it does, it does on the computer it is standing on: a file here is a file on that
 * computer's own disk, and a line run here is run at that computer's own prompt. Nothing of the
 * network is reached from here; a program that wants the network asks the Gateway for it by name.
 */
class Agent {

    static void Main() {
        if (!Gateway.Online) {
            return;
        }
        Gateway.Serve(Answer);
    }

    /*
     * One question, answered. What comes back goes to the program that asked, in the shape it expects:
     * a yes or no for the ones that do something, the text for a file, the lines for everything else.
     */
    static object Answer(List<string> asked) {
        if (asked.Count == 0) {
            return null;
        }
        string verb = asked[0];
        string one = "";
        string two = "";
        if (asked.Count > 1) {
            one = asked[1];
        }
        if (asked.Count > 2) {
            two = asked[2];
        }
        if (verb == "run") {
            List<string> given = new List<string>();
            for (int i = 2; i < asked.Count; i = i + 1) {
                given.Add(asked[i]);
            }
            Process started = Program.Start(one, given);
            return started.ExitCode == 0;
        }
        if (verb == "shell") {
            return Program.Shell(one);
        }
        if (verb == "read") {
            return File.Read(one);
        }
        if (verb == "write") {
            return File.Write(one, two);
        }
        if (verb == "list") {
            return File.List(one);
        }
        return null;
    }
}
