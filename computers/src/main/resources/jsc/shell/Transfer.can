using System.*;
using System.IO.*;
using System.Utils.*;
using System.Collections.*;
using System.Execution.*;
using System.Network.*;

namespace Jsc;

/*
 * Carrying one file across a Gateway, in either direction.
 *
 * This is what the "gateway get" and "gateway put" lines at a prompt actually run. It is a program
 * rather than something the prompt does itself for one reason: a computer over there answers when it
 * gets to it, which may be several ticks later, and a program is the thing that can wait for that
 * without holding anything up. It waits where it stands, costs nothing while it waits, and prints at
 * the terminal it was started from like any other program.
 *
 * A program of ours going the other way is translated as it goes, because that is what going to one of
 * their computers means; anything else crosses as it is.
 */
class Transfer {

    static void Main() {
        List<string> args = Program.Args;
        if (args.Count < 4) {
            Console.PrintLine("transfer: get|put <computer> <there> <here>");
            return;
        }
        string verb = args[0];
        int computer = Convert.ToInt(args[1]);
        string there = args[2];
        string here = args[3];
        if (verb == "get") {
            Get(computer, there, here);
            return;
        }
        Put(computer, there, here);
    }

    static void Get(int computer, string there, string here) {
        string text = Gateway.Read(computer, there);
        if (text == "") {
            Console.PrintLine("Nothing came back from computer " + computer + " for " + there + ".");
            return;
        }
        if (!File.Write(here, text)) {
            Console.PrintLine("Could not write " + here + ".");
            return;
        }
        Console.PrintLine("Copied " + there + " from computer " + computer + " to " + here + ".");
    }

    static void Put(int computer, string there, string here) {
        string text = "";
        string lower = here.ToLower();
        if (lower.EndsWith(".can") || lower.EndsWith(".asm") || lower.EndsWith(".lua")) {
            /* A program crosses as what that computer runs, translated on the way. */
            text = Gateway.Program(here);
        } else {
            text = File.Read(here);
        }
        if (text == "") {
            Console.PrintLine("There is nothing in " + here + " to send.");
            return;
        }
        if (!Gateway.Write(computer, there, text)) {
            Console.PrintLine("Computer " + computer + " did not take " + there + ".");
            return;
        }
        Console.PrintLine("Copied " + here + " to " + there + " on computer " + computer + ".");
    }
}
