    {
      "type": "listing",
      "language": "sg",
      "lines": [
        "class Maths",
        "{",
        "    static int Twice(int x) { return x * 2; }",
        "",
        "    static bool Split(int total, out int half)",
        "    {",
        "        if (total % 2 != 0)",
        "        {",
        "            half = 0;",
        "            return false;",
        "        }",
        "        half = total / 2;",
        "        return true;",
        "    }",
        "}"
      ],
      "name": "Maths.sg"
    },
