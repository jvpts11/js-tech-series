        "using System.*;",
        "",
        "namespace Shop;",
        "",
        "struct Money",
        "{",
        "    public long Cents;",
        "    public static Money operator +(Money a, Money b)",
        "    {",
        "        Money sum = new Money();",
        "        sum.Cents = a.Cents + b.Cents;",
        "        return sum;",
        "    }",
        "}",
        "",
        "static class Prices",
        "{",
        "    public static Money Cents(this long n)",
        "    {",
        "        Money made = new Money();",
        "        made.Cents = n;",
        "        return made;",
        "    }",
        "}",
        "",
        "class Till",
        "{",
        "    static void Main()",
        "    {",
        "        long price = 150;",
        "        long tip = 25;",
        "        Money total = price.Cents() + tip.Cents();",
        "        Console.PrintLine(\"\" + total.Cents);",
        "    }",
        "}"
      ],
      "name": "Money.sgs"
