      "lines": [
        "using System.*;",
        "",
        "namespace Tools;",
        "",
        "static class Small",
        "{",
        "    static int Sum(params int[] values)",
        "    {",
        "        int total = 0;",
        "        for (int i = 0; i < values.Length; i++)",
        "        {",
        "            total += values[i];",
        "        }",
        "        return total;",
        "    }",
        "",
        "    static void Main()",
        "    {",
        "        int Twice(int n) => n * 2;",
        "        int sum = Sum(1, 2, 3);",
        "        Console.PrintLine(nameof(sum) + \" = \" + Twice(sum));",
        "    }",
        "}"
      ],
      "name": "Small.sgs"
