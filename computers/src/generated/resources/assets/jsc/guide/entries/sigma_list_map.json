      "lines": [
        "using System.*;",
        "using System.Collections.*;",
        "using System.IO.*;",
        "",
        "namespace Inventory;",
        "",
        "class Stock",
        "{",
        "    static void Main()",
        "    {",
        "        Map<string, int> count = new Map<string, int>();",
        "        count.Put(\"apple\", 3);",
        "        int got;",
        "        if (count.TryGet(\"apple\", out got))",
        "        {",
        "            Console.PrintLine(\"\" + got);",
        "        }",
        "        List<string> names = count.Keys();",
        "        foreach (string name in names)",
        "        {",
        "            Console.PrintLine(name);",
        "        }",
        "    }",
        "}"
      ],
