        "",
        "namespace Tools;",
        "",
        "class Parse",
        "{",
        "    static void Main()",
        "    {",
        "        try",
        "        {",
        "            int n = Convert.ToInt(\"seven\");",
        "            Console.PrintLine(\"\" + n);",
        "        }",
        "        catch (FormatException failed)",
        "        {",
        "            Console.PrintLine(\"not a number: \" + failed.Message);",
        "        }",
        "        finally",
        "        {",
        "            Console.PrintLine(\"done\");",
        "        }",
        "    }",
        "}"
