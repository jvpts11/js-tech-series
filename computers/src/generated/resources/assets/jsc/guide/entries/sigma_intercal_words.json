        "namespace Tools;",
        "",
        "class Odd",
        "{",
        "    static void Main()",
        "    {",
        "        int count = 1;",
        "        ignore count;",
        "        count = 99;",
        "        remember count;",
        "        abstainfrom loud;",
        "        {",
        "        loud:",
        "            printf(\"never printed\\n\");",
        "        }",
        "        printf(\"%d\\n\", count);",
        "    }",
        "}"
      ],
