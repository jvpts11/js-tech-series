          },
          {
            "words": "jsc.guide.programming_buses.table1_3_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' FILTER ONLY iron_ore, coal"
          },
          {
            "words": "jsc.guide.programming_buses.table1_4_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' FILTER ALL BUT dirt"
          },
          {
            "words": "jsc.guide.programming_buses.table1_5_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' FILTER NONE"
          },
          {
            "words": "jsc.guide.programming_buses.table1_6_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' FILTER TAG c:ores, c:logs"
          },
          {
            "words": "jsc.guide.programming_buses.table1_7_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' MATCH FUZZY"
          },
          {
            "words": "jsc.guide.programming_buses.table1_8_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' KEEP 16 MAX 64"
          },
          {
            "words": "jsc.guide.programming_buses.table1_9_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' KEEP iron_ore 16 MAX iron_ore 64"
          },
          {
            "words": "jsc.guide.programming_buses.table1_10_2"
          }
        ],
        [
          {
            "literal": "SET BUS 'Ore in' PRIORITY 5"
          },
          {
            "words": "jsc.guide.programming_buses.table1_11_2"
          }
        ],
        [
