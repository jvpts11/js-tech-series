        "jsc.guide.programming_buses.table2_head1",
        "jsc.guide.programming_buses.table2_head2"
      ],
      "rows": [
        [
          {
            "literal": "bus(\"Ore in\").Only(\"iron_ore, coal\");"
          },
          {
            "words": "jsc.guide.programming_buses.table2_1_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").AllBut(\"dirt\");"
          },
          {
            "words": "jsc.guide.programming_buses.table2_2_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").Tag(\"c:ores\");"
          },
          {
            "words": "jsc.guide.programming_buses.table2_3_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").Fuzzy(true);"
          },
          {
            "words": "jsc.guide.programming_buses.table2_4_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").Keep(16).Max(64);"
          },
          {
            "words": "jsc.guide.programming_buses.table2_5_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").Item(\"iron_ore\").Keep(16);"
          },
          {
            "words": "jsc.guide.programming_buses.table2_6_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").Priority(5);"
          },
          {
            "words": "jsc.guide.programming_buses.table2_7_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").WhenStock(\"iron_ore\", 512);"
          },
          {
            "words": "jsc.guide.programming_buses.table2_8_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").Between(18, 6);"
          },
          {
            "words": "jsc.guide.programming_buses.table2_9_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").After(bus(\"Coal in\"));"
          },
          {
            "words": "jsc.guide.programming_buses.table2_10_2"
          }
        ],
        [
          {
            "literal": "bus(\"Ore in\").OnDemand();"
          },
          {
            "words": "jsc.guide.programming_buses.table2_11_2"
          }
        ]
      ]
