    {
      "type": "listing",
      "language": "sg",
      "lines": [
        "namespace Tools;",
        "",
        "struct Cell",
        "{",
        "    public int Value;",
        "    public Cell* Next;",
        "}",
        "",
        "class Cells",
        "{",
        "    static void Main()",
        "    {",
        "        Cell* first = null;",
        "        for (int i = 1; i <= 3; i++)",
        "        {",
        "            Cell* made = calloc(1, sizeof(Cell));",
        "            made->Value = i;",
        "            made->Next = first;",
        "            first = made;",
        "        }",
        "        int total = 0;",
        "        for (Cell* at = first; at != null; at = at->Next)",
        "        {",
        "            total += at->Value;",
        "        }",
        "        printf(\"%d\\n\", total);",
        "    }",
        "}"
      ],
      "name": "Cells.sg"
    },
