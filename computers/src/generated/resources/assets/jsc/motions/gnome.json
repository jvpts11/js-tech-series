{
  "dialog_open": {
    "duration": 100,
    "easing": "ease-out-quad",
    "from": 1.0,
    "from_y": 0.0,
    "group": "animations",
    "style": "scale",
    "to": 1.0
  },
  "menu_show": {
    "duration": 250,
    "easing": "ease-out-quad",
    "from": 0.97,
    "group": "animations",
    "opacity_from": 0.0,
    "style": "scale",
    "to": 1.0
  },
  "pointer_busy": {
    "duration": 960,
    "easing": "linear",
    "frames": 16.0,
    "steady": 1.0,
    "style": "loop"
  },
  "pointer_working": {
    "duration": 960,
    "easing": "linear",
    "frames": 16.0,
    "steady": 1.0,
    "style": "loop"
  },
  "progress_fill": {
    "duration": 250,
    "easing": "ease-out-quad",
    "group": "animations",
    "style": "ease"
  },
  "progress_wait": {
    "duration": 1000,
    "easing": "ease-in-out",
    "length": 0.2,
    "steady": 1.0,
    "style": "bounce"
  },
  "scene_fade": {
    "duration": 250,
    "easing": "ease-out-quad",
    "style": "fade"
  },
  "window_close": {
    "duration": 150,
    "easing": "ease-out-quad",
    "from": 1.0,
    "group": "animations",
    "opacity_to": 0.0,
    "style": "scale",
    "to": 0.8
  },
  "window_minimize": {
    "duration": 400,
    "easing": "ease-out-expo",
    "group": "animations",
    "out": 1.0,
    "style": "zoom"
  },
  "window_open": {
    "duration": 150,
    "easing": "ease-out-expo",
    "from": 0.01,
    "from_y": 0.05,
    "group": "animations",
    "opacity_from": 0.0,
    "pivot_y": 1.0,
    "style": "scale",
    "to": 1.0
  },
  "window_restore": {
    "duration": 400,
    "easing": "ease-out-expo",
    "group": "animations",
    "style": "zoom"
  }
}