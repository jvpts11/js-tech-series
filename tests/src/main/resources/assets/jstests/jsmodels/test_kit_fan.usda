#usda 1.0
(
    defaultPrim = "fan"
    doc = "A desk fan, its blades turning once a second, in centimetres as a scene program writes them"
    metersPerUnit = 0.01
    upAxis = "Y"
    startTimeCode = 0
    endTimeCode = 24
    timeCodesPerSecond = 24
)

def Xform "fan"
{
    def Mesh "base"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 3, 7, 6, 2, 0, 4, 7, 3, 1, 2, 6, 5]
        point3f[] points = [(-20, 0, -20), (20, 0, -20), (20, 6, -20), (-20, 6, -20), (-20, 0, 20), (20, 0, 20), (20, 6, 20), (-20, 6, 20)]
        color3f[] primvars:displayColor = [(0.25, 0.27, 0.3)] (
            interpolation = "constant"
        )
    }

    def Mesh "pole"
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 3, 7, 6, 2, 0, 4, 7, 3, 1, 2, 6, 5]
        point3f[] points = [(-3, 6, -3), (3, 6, -3), (3, 48, -3), (-3, 48, -3), (-3, 6, 3), (3, 6, 3), (3, 48, 3), (-3, 48, 3)]
        color3f[] primvars:displayColor = [(0.6, 0.62, 0.66)] (
            interpolation = "constant"
        )
    }

    def Xform "head"
    {
        double3 xformOp:translate = (0, 52, 0)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Mesh "motor"
        {
            int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
            int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 3, 7, 6, 2, 0, 4, 7, 3, 1, 2, 6, 5]
            point3f[] points = [(-8, -8, -14), (8, -8, -14), (8, 8, -14), (-8, 8, -14), (-8, -8, 4), (8, -8, 4), (8, 8, 4), (-8, 8, 4)]
            color3f[] primvars:displayColor = [(0.23, 0.44, 0.77)] (
                interpolation = "constant"
            )
        }

        def Xform "blades"
        {
            double3 xformOp:translate = (0, 0, 6)
            float xformOp:rotateZ = 0
            float xformOp:rotateZ.timeSamples = {
                0: 0,
                6: 90,
                12: 180,
                18: 270,
                24: 360,
            }
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:rotateZ"]

            def Mesh "blade_a"
            {
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 3, 7, 6, 2, 0, 4, 7, 3, 1, 2, 6, 5]
                point3f[] points = [(-24, -3, -1), (24, -3, -1), (24, 3, -1), (-24, 3, -1), (-24, -3, 1), (24, -3, 1), (24, 3, 1), (-24, 3, 1)]
                color3f[] primvars:displayColor = [(0.91, 0.76, 0.29)] (
                    interpolation = "constant"
                )
            }

            def Mesh "blade_b"
            {
                int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
                int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 3, 7, 6, 2, 0, 4, 7, 3, 1, 2, 6, 5]
                point3f[] points = [(-3, -24, -1), (3, -24, -1), (3, 24, -1), (-3, 24, -1), (-3, -24, 1), (3, -24, 1), (3, 24, 1), (-3, 24, 1)]
                color3f[] primvars:displayColor = [(0.91, 0.76, 0.29)] (
                    interpolation = "constant"
                )
            }
        }
    }
}
